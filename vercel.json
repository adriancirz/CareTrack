{
  "functions": {
    "**/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.php"
    },
    {
      "source": "/caretrack",
      "destination": "/index.php"
    },
    {
      "source": "/caretrack/:path*",
      "destination": "/:path*"
    }
  ]
}
