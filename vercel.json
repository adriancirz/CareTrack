{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.php?path=index.php"
    },
    {
      "source": "/caretrack",
      "destination": "/api/index.php?path=index.php"
    },
    {
      "source": "/caretrack/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/caretrack/:path*",
      "destination": "/api/index.php?path=:path*"
    }
  ]
}
